# ==========================================
# Server-Monitor PWA - Configuration Template
# ==========================================

APP_ENV=production
LOG_LEVEL=INFO
APP_PORT=8085

# Beszel Hub API (Read-only server & container telemetry)
BESZEL_URL=http://host.docker.internal:8090
BESZEL_EMAIL=admin@example.local
BESZEL_PASSWORD=changeme_local
BESZEL_TIMEOUT_SECONDS=3.0

# Optional News-AI API (for Nokia 6.1 battery history)
NEWS_AI_API_URL=http://news_ai_app:8000
NEWS_AI_TIMEOUT_SECONDS=4.0

# Public ports used for quick links on Agents page
BESZEL_PUBLIC_PORT=8090
ADGUARD_PUBLIC_PORT=3053
